#!/bin/sh
# Cross-platform: use Node.js to read the first line
FIRST_LINE=$(node -pe "require('fs').readFileSync(process.argv[1],'utf8').split('\\n')[0]" "$1")
if ! echo "$FIRST_LINE" | grep -qE "^(feat|fix|ci|chore|docs|test|style|refactor|perf|build|revert)(\(.+?\))?: .{1,}\[.{0,10}\]$"; then
    echo "Aborting commit. Your commit message is invalid." >&2
    exit 1
fi
if ! echo "$FIRST_LINE" | grep -qE "^.{1,88}$"; then
    echo "Aborting commit. Your commit message is too long." >&2
    exit 1
fi